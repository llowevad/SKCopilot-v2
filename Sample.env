# SKCopilot-v2 Environment Configuration
#
# Copy this file to `.env` in the repo root and fill in your values:
#   cp Sample.env .env
#
# The .env file is gitignored and will NOT be published to GitHub.
# Scripts in /scripts will auto-load values from .env when present.

# ──────────────────────────────────────────────
# Azure Subscription & Tenant
# ──────────────────────────────────────────────

# Your Azure subscription ID (Azure Portal > Subscriptions)
AZURE_SUBSCRIPTION_ID=<your-azure-subscription-id>

# Your Entra ID (Azure AD) tenant ID (Azure Portal > Azure Active Directory > Overview)
AZURE_TENANT_ID=<your-tenant-id>

# ──────────────────────────────────────────────
# Entra ID App Registration
# ──────────────────────────────────────────────

# Application (client) ID from the Entra ID app registration
# Obtain from: scripts/register-bot.ps1 output or Azure Portal > App Registrations
BOT_APP_ID=<your-bot-app-id>

# Object ID of the app registration (used for API configuration)
BOT_APP_OBJECT_ID=<your-app-object-id>

# Client secret for the app registration
# ⚠️ NEVER commit real values — use Azure Key Vault in production
BOT_CLIENT_SECRET=<your-client-secret>

# ──────────────────────────────────────────────
# Azure Bot Service
# ──────────────────────────────────────────────

# Azure Bot resource name
BOT_NAME=<your-bot-name>

# Resource group containing the Bot and App Service resources
RESOURCE_GROUP=<your-resource-group>

# ──────────────────────────────────────────────
# Azure App Service Domains (without https://)
# ──────────────────────────────────────────────

# CopilotAgent (Layer 3) App Service domain
COPILOT_APP_DOMAIN=<your-copilot-app>.azurewebsites.net

# Orchestrator (Layer 1) App Service domain
ORCHESTRATOR_APP_DOMAIN=<your-orchestrator-app>.azurewebsites.net

# WebChat (Layer 2) App Service domain
WEBCHAT_APP_DOMAIN=<your-webchat-app>.azurewebsites.net
