# SKCopilot-v2 Teams App Environment Configuration (Development)
# 
# These values are populated after Azure Bot registration and deployment.
# See: scripts/register-bot.ps1 for bot registration
# See: src/CopilotAgent/appPackage/README.md for full setup instructions

# Azure Bot App Registration ID
# Obtain from: scripts/register-bot.ps1 output or Azure Portal > App Registrations
BOT_ID=<from-azure-bot-registration>

# Bot messaging endpoint domain (without https://)
# For Azure App Service deployment, this is: {app-service-name}.azurewebsites.net
BOT_DOMAIN=<your-copilot-app>.azurewebsites.net

# Full messaging endpoint URL
# Must match the endpoint configured in Azure Bot resource
BOT_ENDPOINT=https://<your-copilot-app>.azurewebsites.net/api/messages

# Azure AD Tenant ID
# Obtain from: scripts/register-bot.ps1 output or Azure Portal > Azure Active Directory > Overview
TENANT_ID=<azure-ad-tenant-id>

# Client Secret (NEVER commit this value - use Azure Key Vault or User Secrets in production)
# Obtain from: scripts/register-bot.ps1 output (only shown once)
CLIENT_SECRET=<use-dotnet-user-secrets-or-key-vault>

# Example for production deployment:
# BOT_ID=12345678-1234-1234-1234-123456789012
# BOT_DOMAIN=<your-copilot-app>.azurewebsites.net
# BOT_ENDPOINT=https://<your-copilot-app>.azurewebsites.net/api/messages
# TENANT_ID=87654321-4321-4321-4321-210987654321
# CLIENT_SECRET=<stored-in-azure-key-vault>
